# Database (MongoDB connection string for TTS audio caching and user stats)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/useladder?retryWrites=true&w=majority

# Authentication & Session Security (Min 32 characters for HMAC SHA-256 JWT signing)
AUTH_SECRET=your_super_secret_auth_key_at_least_32_characters_long

# Administrator Email Whitelist (Comma-separated emails with admin privileges)
ADMIN_EMAILS=admin@useladder.com,allen@example.com

# Google OAuth (Client ID from Google Cloud Console for Google Sign-In)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ElevenLabs Text-to-Speech API
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# YarnGPT Text-to-Speech API (Nigerian localized voice models)
YARNGPT_API_KEY=your_yarngpt_api_key_here

# Google Gemini AI API (Dynamic probing, speech evaluation & interview feedback)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Anthropic Claude API (Fallback LLM provider)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cloudflare R2 Storage (S3-compatible persistent audio cache)
R2_ACCOUNT_ID=your_cloudflare_account_id_or_endpoint_url
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=useladder-tts
R2_PUBLIC_DOMAIN=https://your-public-r2-domain.r2.dev

# Azure Speech (Nigerian TTS voices + realtime Voice Live interviews)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=westus3

# Realtime voice interviews (/interview/realtime) — run the relay with `npm run voice-relay`
# Model must be available in AZURE_SPEECH_REGION (gpt-4.1-mini works in westus3)
VOICE_LIVE_MODEL=gpt-4.1-mini
VOICE_RELAY_PORT=8787
# Where browsers reach the relay (use wss://… when deployed)
NEXT_PUBLIC_VOICE_RELAY_URL=ws://localhost:8787

# Optional: Gemini models to try, most preferred first
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
